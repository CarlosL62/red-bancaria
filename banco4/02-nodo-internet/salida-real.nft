table ip salida_real {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth2" ip saddr 100.64.0.0/10 masquerade
		oifname "eth2" ip saddr 200.4.1.0/30 masquerade
		oifname "eth2" ip saddr 200.4.2.0/30 masquerade
		oifname "eth0" ip daddr 200.4.1.2 tcp dport 8080 masquerade
		oifname "eth1" ip daddr 200.4.2.2 tcp dport 8080 masquerade
		oifname "eth3" ip saddr { 200.4.1.0/30, 200.4.2.0/30 } masquerade
		oifname "eth4" ip saddr { 200.4.1.0/30, 200.4.2.0/30 } masquerade
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname { "eth3", "eth4" } tcp dport 8080 dnat to 200.4.1.2:8080
	}

	chain output {
		type nat hook output priority dstnat; policy accept;
		ip daddr { 10.0.0.10, 10.0.0.13 } tcp dport 8080 dnat to 200.4.1.2:8080
	}
}
